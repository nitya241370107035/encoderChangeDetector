# ==========================================
# AeroLens Git Ignore Rules
# ==========================================

# 1. Satellite Imagery, Rasters, Tiles & Previews
*.tif
*.tiff
*.jpg
*.jpeg
*.png
*.webp
*.jp2
*.bmp
*.npy
*.npz
data/tiles/
data/uploads/
data/processed_scenes/
data/cache/
data/change_staging/
data/datasets/
!data/README.md
!data/custom_aoi.geojson
!data/runs/**/*.png




# 2. Model Checkpoints & Large Weights (>100MB)
models/retrieval/*.pt
models/retrieval/*.bin
models/retrieval/*.safetensors
models/retrieval/*.onnx
*.pt
*.bin
*.safetensors
*.onnx
*.weights
*.h5
*.pkl

# 3. Reference & External Repositories
SIH2026/

# 4. Python Cache, Bytecode & Testing Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 5. Virtual Environments
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# 6. IDE, OS & System Generated Logs
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
scratch/
.system_generated/

# 7. Archives & Compressed Dumps
.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# 8. Temporary & Local Evaluation Scratch Scripts
compare_*.py
generate_*.py
scratch_*.py
show_cloudy_tiles.py
verify_*.py
datasets/defense_strategic_bases.geojson
